HOST=127.0.0.1
PORT=3001
CACHE_PATH=.cache/worlds-2026.json
REQUEST_TIMEOUT_MS=20000

# Vercel only: connect Upstash to the project or set these server-side variables.
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL / KV_REST_API_TOKEN are also supported.
# Your Marketplace prefix is supported too:
# CACHE_WORLDS_KV_REST_API_URL / CACHE_WORLDS_KV_REST_API_TOKEN
# REDIS_CACHE_KEY=worlds-board:production:v1
